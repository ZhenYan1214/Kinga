{
  "name": "kinga",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Offline, on-device scam guard for M-Pesa and USDT, built on Tether QVAC and WDK.",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=24.9.0"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "spike:download": "tsx spikes/download-model.ts",
    "spike:llm": "tsx spikes/llm-json.ts",
    "spike:wdk": "tsx spikes/wdk-sepolia.ts",
    "test": "tsx --test packages/*/test/*.test.ts",
    "typecheck": "tsc && tsc -p apps/web",
    "eval": "tsx eval/run.ts",
    "spike:wallet": "tsx spikes/wallet-sepolia.ts",
    "dev:server": "tsx watch apps/server/src/main.ts",
    "start": "tsx apps/server/src/main.ts",
    "dev:web": "npm run dev -w apps/web",
    "build:web": "npm run build -w apps/web",
    "demo:reset": "node -e \"require('fs').rmSync('.kinga/wallet-state.json',{force:true})\"",
    "offline-proof": "tsx scripts/offline-proof.ts",
    "spike:download-vision": "tsx spikes/download-vision.ts",
    "eval:ledger": "tsx eval/ledger.ts"
  },
  "dependencies": {
    "@qvac/sdk": "0.22.0",
    "@tetherto/wdk": "1.0.0-beta.22",
    "@tetherto/wdk-wallet-evm": "1.0.0-beta.24"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  },
  "overrides": {
    "@tetherto/wdk-wallet": "1.0.0-beta.21",
    "zod": "4.6.6"
  }
}
