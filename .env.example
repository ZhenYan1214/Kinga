# Copy to .env. Never put a seed that holds real funds here: Kinga runs on the Sepolia testnet only.

# Test wallet seed phrase. `npm run spike:wdk` creates one and writes it to .env for you.
KINGA_TEST_SEED=

# Sepolia test USDT contract (from the Pimlico or Candide faucet). Without it, broadcasting stays disabled.
KINGA_USDT_ADDRESS=
